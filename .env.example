# Copy this file to ".env" and fill in the values. Never commit ".env" to GitHub.
# Variables that start with VITE_ are visible to anyone who opens the website,
# so only put PUBLIC values here. Never put the service role key or the
# admin request code in this file - those stay on the server (Supabase secrets).

# Needed from Phase 2 onward (Supabase > Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
